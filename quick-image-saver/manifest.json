{
  "manifest_version": 3,
  "name": "快存图片",
  "version": "1.3.0",
  "description": "一键保存网页图片，可开启 B 站、YouTube 和 X 视频下载。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "offscreen", "contextMenus", "downloads", "scripting", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {
    "default_title": "快存图片 · 保存位置与设置",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }]
}
